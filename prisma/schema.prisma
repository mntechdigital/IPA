// Prisma schema for IPA Media Research CMS.
// The database is the CMS's dynamic layer. Static site defaults stay in src/data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Singleton config rows (wholesale-edited JSON blobs) ----------

model CmsMeta {
  id          String   @id @default(uuid())
  version     String
  lastUpdated DateTime @db.Timestamp(3)
}

model SiteSettings {
  id   String @id @default(uuid())
  data Json
}

model HomePageData {
  id   String @id @default(uuid())
  data Json
}

model AboutPageData {
  id   String @id @default(uuid())
  data Json
}

model ContactPageData {
  id   String @id @default(uuid())
  data Json
}

model ResearchPageData {
  id   String @id @default(uuid())
  data Json
}

model MonitoringTelemetry {
  id   String @id @default(uuid())
  data Json
}

// ---------- CRUD entities ----------

model ResearchBeat {
  id                   String  @id @default(uuid())
  slug                 String? @unique
  beatNumber           String
  category             String
  name                 String
  tagline              String
  description          String  @db.Text
  image                String
  outputsCount         String
  timeframe            String
  status               String
  leadFellows          Json
  metrics              Json
  overview             Json
  keyQuestions         Json
  methodologyDetails   Json
  caseStudies          Json
  publications         Json
  summary              String?
  methodology          String? @db.Text
  primaryMethodologies Json
  imageTitle           String?
  imageSubtitle        String?
  researchNarrative    String? @db.Text
  viewCount            Int?
  createdAt            DateTime @default(now()) @db.Timestamp(3)
  updatedAt            DateTime @updatedAt @db.Timestamp(3)
  nameBn               String? @db.Text
  taglineBn            String? @db.Text
  descriptionBn        String? @db.Text
  summaryBn            String? @db.Text
  methodologyBn        String? @db.Text
  researchNarrativeBn  String? @db.Text
  statusBn             String? @db.Text
  timeframeBn          String? @db.Text
  outputsCountBn       String? @db.Text
  imageTitleBn         String? @db.Text
  imageSubtitleBn      String? @db.Text
  leadFellowsBn        Json?
  metricsBn            Json?
  overviewBn           Json?
  keyQuestionsBn       Json?
  methodologyDetailsBn Json?
  caseStudiesBn        Json?
  publicationsBn       Json?
  sampleInquiries      Json?
  sampleInquiriesBn    Json?
  primaryMethodologiesBn Json?
  imageBn              String?
}

model TeamMember {
  id                   String  @id @default(uuid())
  name                 String
  nameBn               String? @db.Text
  role                 String
  roleBn               String? @db.Text
  category             String
  teamType             String?
  image                String
  bio                  String  @db.Text
  bioBn                String? @db.Text
  fullBio              String? @db.Text
  fullBioBn            String? @db.Text
  researchInterests    Json
  researchInterestsBn  Json?
  focusAreas           Json
  focusAreasBn         Json?
  education            String?
  educationBn          String? @db.Text
  recentPublications   Json
  email                String
  twitter              String?
  linkedin             String?
  scholar              String?
  order                Int?
  createdAt            DateTime @default(now()) @db.Timestamp(3)
  updatedAt            DateTime @updatedAt @db.Timestamp(3)
}

model Publication {
  id          String  @id @default(uuid())
  title       String  @db.Text
  type        String
  date        String
  pagesOrSize String
  beatId      String?
  downloadUrl String?
  abstract    String? @db.Text
  status      String?
  createdAt   DateTime @default(now()) @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @db.Timestamp(3)
}

model Inquiry {
  id               String   @id @default(uuid())
  date             String
  name             String   @db.Text
  organization     String   @db.Text
  email            String
  topic            String   @db.Text
  message          String   @db.Text
  requestedDataset String?
  status           String
  notes            String? @db.Text
  createdAt        DateTime @default(now()) @db.Timestamp(3)
  updatedAt        DateTime @updatedAt @db.Timestamp(3)
}

model WorkArea {
  id               String   @id @default(uuid())
  name             String
  tagline          String   @db.Text
  description      String   @db.Text
  methods          Json
  sampleInquiries  Json
  image            String
  outputsCount     String
  timeframe        String
  status           String
  nameBn           String?  @db.Text
  taglineBn        String?  @db.Text
  descriptionBn    String?  @db.Text
  methodsBn        Json?
  sampleInquiriesBn Json?
  imageBn          String?
  outputsCountBn   String?
  createdAt        DateTime @default(now()) @db.Timestamp(3)
  updatedAt        DateTime @updatedAt @db.Timestamp(3)
}

model WorkProcessPillar {
  id          String   @id @default(uuid())
  step        String
  title       String
  subtitle    String
  description String   @db.Text
  highlights  Json
  titleBn     String?  @db.Text
  subtitleBn  String?  @db.Text
  descriptionBn String? @db.Text
  highlightsBn Json?
  createdAt   DateTime @default(now()) @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @db.Timestamp(3)
}

model ActivityLog {
  id        String   @id @default(uuid())
  timestamp String
  action    String
  section   String
  user      String
  createdAt DateTime @default(now()) @db.Timestamp(3)
}